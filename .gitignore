# ── internal ──────────────────────────────────────────────────────────────────
# Working notes, build strategy, agent task briefs, pitch material.
# Development artefacts, not part of the shipped product.
internal/
.grok/
AGENTS.md
CLAUDE.md

# ── secrets ───────────────────────────────────────────────────────────────────
.env
.env.local
.env*.local
!.env.example

# ── data ──────────────────────────────────────────────────────────────────────
# Raw COPS archives are 45 GB — fetch with scripts/osf_download.py, never commit.
data/cops/raw/
data/cops/interim/
data/cops/features/
*.parquet
*.joblib
*.pkl

# Third-party originals (the authors' MATLAB scripts, the blank diary form,
# demographics) belong to the COPS authors — fetched, not vendored.
data/cops/meta/

# data/cops/derived/ IS tracked: our own label extraction, ~1.5 MB, no raw signal.

# ── python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── node / next ───────────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# ── vercel / supabase ─────────────────────────────────────────────────────────
.vercel/
supabase/.branches/
supabase/.temp/

# ── os / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json

# Local agent tooling — the impeccable design skill and its hooks. Development
# apparatus, not product, and gitignore has no inline comments so this sits on
# its own line.
.claude/

# ── film ──────────────────────────────────────────────────────────────────────
# Captured clips, renders and the raw voice take. The capture scripts, the scene
# manifest and the Remotion source ARE tracked — the point is that the film
# rebuilds from source. These are the outputs and the one input that happens to
# be a recording of a real person's voice, which does not belong in a public
# repo by default. Uncomment if you decide otherwise.
film/capture/out/
film/capture/assets/
film/out/
note.wav.m4a

# ── scratch ───────────────────────────────────────────────────────────────────
scratch/
*.log

# trained model artifacts (regenerate with ml/scripts/train*.py)
data/cops/artifacts/

# LaTeX intermediates (the .tex and the built .pdf are both tracked)
docs/whitepaper/*.aux
docs/whitepaper/*.log
docs/whitepaper/*.out
.tooling/
