# Astrolabe app env (copy to .env.local). No secrets that must stay server-only.

# offline (default) | online | supabase
# Only "online" or "supabase" hits the remote bundles table.
NEXT_PUBLIC_DEMO_MODE=offline

# Browser-safe Supabase keys (anon / public). Required only for online mode.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or in any NEXT_PUBLIC_* variable.
# Service role is seed-only — see supabase/README.md and supabase/seed.ts.
